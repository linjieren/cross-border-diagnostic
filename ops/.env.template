# 对外端口
NGINX_PORT=8080
DEV_PORT=8081
MAIN_PORT=80

# 后端
BACKEND_PORT=3000
NODE_ENV=production
# 生产部署（docker-compose.main.yml）必填，缺失时 compose 启动失败；请使用长随机字符串
JWT_SECRET=

# 反馈按钮 (dev=true, main=false)
FEATURE_FEEDBACK_BUTTON=false

# 数据库
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
DEV_DB_PORT=5433

# Redis (内部)

# 其他
TZ=Asia/Shanghai

# 登录验证码发送通道（生产必填其一，全部缺失时 magic-link 返回 503）
# 邮件 SMTP（如 SES / 企业邮箱 / Gmail 应用密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 短信（阿里云 SMS，签名与模板需已在控制台审核通过）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou
